{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PRIVIA",
  "version": "1.0.0",
  "identifier": "app.privia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PRIVIA",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#08090B",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; media-src 'self' blob: data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "Your space. Your intelligence.",
    "longDescription": "PRIVIA is a private, local-first AI assistant. It runs on your computer with a local model through Ollama, asks before it acts, and keeps a full record of what it did.",
    "copyright": "Copyright PRIVIA Contributors. Apache-2.0.",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/privia-backend"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "windows": { "digestAlgorithm": "sha256" }
  }
}
