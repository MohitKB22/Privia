# =============================================================================
# PRIVIA - example configuration
# Copy to .env and edit. NEVER commit a real .env file.
# Every value below is optional: PRIVIA boots with safe local-first defaults.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development                  # development | test | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
PRIVIA_HOST=127.0.0.1                # bind address; non-loopback requires PRIVIA_API_TOKEN
PRIVIA_PORT=8756
PRIVIA_DATA_DIR=                     # defaults to ~/.privia

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/privia.db

# --- Local AI (default path, no cloud) ---------------------------------------
LOCAL_LLM_PROVIDER=ollama            # ollama | heuristic
LOCAL_LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_EMBEDDING_PROVIDER=local       # local | ollama
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# --- Cloud AI (OPT-IN, disabled by default) ----------------------------------
CLOUD_PROCESSING_ENABLED=false
CLOUD_LLM_PROVIDER=                  # openai | anthropic
CLOUD_LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# --- Speech ------------------------------------------------------------------
STT_PROVIDER=faster-whisper          # faster-whisper | disabled
STT_MODEL=base.en
STT_COMPUTE_TYPE=int8
TTS_PROVIDER=disabled                # pyttsx3 | disabled

# --- Permissions (comma separated absolute paths) ----------------------------
# Empty means: nothing is readable until you grant it in the Privacy Center.
ALLOWED_DIRECTORIES=
TERMINAL_WORKSPACE_ROOTS=
BROWSER_ALLOWED_DOMAINS=             # empty = all public domains allowed, private IPs always blocked

# --- Email (local-first by default) ------------------------------------------
EMAIL_PROVIDER=local                 # local | smtp | mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                       # prefer the OS keychain over this file
SMTP_STARTTLS=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# --- Calendar ----------------------------------------------------------------
CALENDAR_PROVIDER=local              # local | mock
CALENDAR_ICS_DIR=

# --- Security ----------------------------------------------------------------
PRIVIA_API_TOKEN=                    # required when PRIVIA_HOST is not loopback
SECRETS_BACKEND=file                 # keychain | file
MAX_UPLOAD_BYTES=26214400
MAX_FILE_READ_BYTES=8388608
MAX_TOOL_OUTPUT_BYTES=262144
RATE_LIMIT_PER_MINUTE=120
TELEMETRY_ENABLED=false              # PRIVIA never phones home; kept for explicitness
